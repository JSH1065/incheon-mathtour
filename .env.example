# GitHub Pages에는 docs/만 게시합니다. 이 파일의 실제 값은 연결 서버에서 설정합니다.
PORT=8787
HOST=127.0.0.1
BASE_URL=http://localhost:8787
PAGES_ORIGIN=http://localhost:8787
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 학교 계정: 단일 조직 앱이면 학교의 Directory (tenant) ID로 바꿉니다.
# organizations는 여러 조직 계정을 지원하도록 등록한 앱에서 사용합니다.
MS_TENANT=organizations
STORAGE_MODE=shared-folder
# 미입력 시 DATA_DIR/onedrive-target.json 사용. 공유 링크는 GitHub에 올리지 않습니다.
TARGET_CONFIG_FILE=
# npm run secrets가 생성합니다. GitHub에 올리지 않습니다.
ADMIN_PASSWORD=
CACHE_ENCRYPTION_KEY=
DATA_DIR=.private
NODE_ENV=development
MOCK_ONEDRIVE=0
